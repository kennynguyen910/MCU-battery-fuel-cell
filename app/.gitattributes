# Let Git detect ordinary text, then make cross-platform scripts deterministic.
* text=auto
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
*.js text eol=lf
*.dart text eol=lf
*.sql text eol=lf
*.md text eol=lf

# These formats are binary and must never receive line-ending conversion.
*.png binary
*.jar binary
*.apk binary
*.zip binary
