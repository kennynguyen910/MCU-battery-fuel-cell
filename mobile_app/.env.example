PORT=3001
# Local project database. Blank selects temporary memory mode.
DATABASE_URL=postgresql://capstone@127.0.0.1:55432/capstone
# Set both to require user login for all /api data routes. Use a unique local
# password of at least 12 characters; do not commit the populated .env file.
APP_USERNAME=capstone
APP_PASSWORD=capstone_password
# Initial PostgreSQL account only; existing passwords are never overwritten.
# Add more accounts with START_PROJECT/13_Add_User.cmd (see docs/users.md).
# Bench-only Node UDP relay; production Android receives UDP directly.
# Only explicit BENCH_DEVICE_UDP_ENABLED=1 enables this optional test listener.
BENCH_DEVICE_UDP_ENABLED=0
# DEVICE_IP=192.168.1.50
# DEVICE_UDP_PORT=5005
# Make manual network-test controls available. Traffic starts stopped.
NETWORK_SIMULATION_ENABLED=0
# AWS setup additionally sets this to .local/aws/global-bundle.pem so Node can
# verify that it is communicating with the genuine RDS endpoint over TLS.
# DATABASE_SSL_CA=.local/aws/global-bundle.pem
